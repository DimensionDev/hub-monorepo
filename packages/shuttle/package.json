{
  "name": "@dimensiondev/shuttle",
  "version": "2.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DimensionDev/hub-monorepo.git",
    "directory": "packages/shuttle"
  },
  "dependencies": {
    "@dimensiondev/hub-nodejs": "^0.18.1",
    "@farcaster/hot-shots": "^10.0.0",
    "commander": "11.0.0",
    "dotenv": "16.4.5",
    "ioredis": "5.11.1",
    "kysely": "^0.28.17",
    "neverthrow": "^6.0.0",
    "pg": "^8.12.0",
    "pg-cursor": "^2.10.3",
    "pino": "^8.12.1",
    "pino-pretty": "^10.0.0",
    "sql-formatter": "^13.0.0",
    "tiny-typed-emitter": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "start": "tsx src/example-app/app.ts",
    "dashboard": "tsx src/example-app/dashboard/main.ts",
    "clean": "rimraf ./dist",
    "lint": "biome format src/ --write && biome check src/ --apply",
    "lint:ci": "biome ci src/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --forceExit",
    "test:ci": "ENVIRONMENT=test NODE_OPTIONS=--experimental-vm-modules jest --ci --forceExit --coverage",
    "prepublishOnly": "yarn run build"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "11.0.0",
    "@types/humanize-duration": "3.27.1",
    "@types/node": "20.11.30",
    "@types/pg": "8.10.3",
    "@types/pg-cursor": "2.7.0",
    "biome-config-custom": "*",
    "bullmq": "5.81.5",
    "prettier-config-custom": "*",
    "tsx": "^4"
  }
}
