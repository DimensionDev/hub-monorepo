# Local projection dashboard (pnpm dashboard). Copy to .env.dashboard; never commit the real file.
# Point at the server through an SSH tunnel, e.g.
#   ssh -N -L 55432:127.0.0.1:5432 -L 56379:127.0.0.1:6379 <server>
POSTGRES_URL=postgres://user:password@127.0.0.1:55432/shuttle
POSTGRES_SCHEMA=public
# Optional: Redis Stream backlog, DLQ and the backfill queue. Leave unset to skip.
REDIS_URL=redis://127.0.0.1:56379
